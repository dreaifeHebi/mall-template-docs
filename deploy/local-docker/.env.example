# Local Docker deployment defaults.
# Copy this file to .env and change passwords before using it outside local testing.

POSTGRES_DB=mall
POSTGRES_USER=mall
POSTGRES_PASSWORD=change-me-postgres

REDIS_PASSWORD=change-me-redis

USER_WEB_PORT=8060
ADMIN_WEB_PORT=8090
API_WEB_PORT=8070

SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xmx320m -Xms160m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC

MALL_UPLOAD_PATH=/data/uploads
MALL_UPLOAD_URL=/uploads

MALL_DOMAIN=http://localhost:8060
MALL_ADMIN_BASE_URL=http://mall-admin:8080
FRONTEND_BASE_URL=http://localhost:8060

SPRING_MAIL_FROM=mall@example.com
SES_SMTP_HOST=
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

GLOBEPAY_PARTNER_CODE=
GLOBEPAY_CREDENTIAL_CODE=
GLOBEPAY_NOTIFY_URL=
GLOBEPAY_REDIRECT_URL=
GLOBEPAY_CREDIT_CARD_RETURN_URL=
GLOBEPAY_DEFAULT_CURRENCY=JPY
